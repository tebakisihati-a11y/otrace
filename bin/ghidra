#!/bin/bash
# ghidra wrapper — runs via Podman eclipse-temurin (Java 17)
# Usage: ghidra <target>
GHIDRA_HOME="$HOME/ghidra"
WORK_DIR="$HOME/.ghidra-work"
IMAGE="docker.io/library/eclipse-temurin:21-jdk"

if [ ! -d "$GHIDRA_HOME" ]; then
    echo "ghidra tidak terpasang. Jalankan: bin/install-ghidra.sh" >&2
    exit 1
fi

mkdir -p "$WORK_DIR"

# Copy target files to work dir, build args
ARGS=()
for arg in "$@"; do
    if [ -f "$arg" ]; then
        cp "$arg" "$WORK_DIR/"
        ARGS+=("$(basename "$arg")")
    else
        ARGS+=("$arg")
    fi
done

cd "$WORK_DIR" || exit 1

podman run --rm \
    -v "$GHIDRA_HOME":/opt/ghidra:ro \
    -v "$WORK_DIR":/work \
    -w /work \
    -e GHIDRA_HEADLESS_SUPPORT=true \
    "$IMAGE" \
    /opt/ghidra/support/analyzeHeadless /work -import "${ARGS[@]}" -overwrite -script_path "." -analysis_timeout 30
